{
    "experiment_name": "experiments_sivaprasad_cifar",
    "datasets": "cifar10",
    "constructions": "pgd,direct,lift,exppost,exppost_matched,nonconvex",
    "init_modes": "hk",
    "depths": "3",
    "activations": "elu",
    "seeds": "0",
    "epochs": 40,
    "patience": 8,
    "batch_size": 64,
    "lr": 0.0003,
    "loss_reduction": "mean",
    "train_split": 0.9,
    "eval_test": 1,
    "hidden_dim": 800,
    "lecun_first_layer": 1,
    "hyper_hidden_sizes": "64,64,64",
    "hyper_share_readouts": 0,
    "hyper_readout_fanin_scale": 0,
    "lift_init_match": "elementwise",
    "max_lift_params": 400000000,
    "shoulder_max_coords": 131072,
    "shoulder_rel_frac": 0.1,
    "skip_nonfinite_cells": 1,
    "ce_skip_factor": 10000000,
    "val_every": 200,
    "n_val_probe": 2048,
    "log_every": 25,
    "eval_chunk": 2048,
    "max_steps_per_epoch": 0,
    "ce0_match_rtol": 0.25,
    "draw_match_median_rtol": 0.05,
    "draw_match_occ_atol": 0.01,
    "lift_cond_spread_batches": 8,
    "checkpoint_every_epochs": 1,
    "save_weights": 1,
    "gpu_memory_fraction": 0.0,
    "data_on_device": 1,
    "gpu_id": 0,
    "resume": 1,
    "phase": "train"
}
